# Copie este arquivo pra ".env.local" (NÃO commitar o .env.local — já está no .gitignore)
# e preencha com os valores reais. Na Vercel, as mesmas chaves vão em
# Project Settings > Environment Variables.

# Supabase (mesmo projeto do DirectGov, do agendador-stories e do Chatbot Direct — só as tabelas
# são novas, prefixo shoppinghub_)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chave pública (Publishable key, sb_publishable_...) do MESMO projeto Supabase acima — usada só
# pro login do painel administrativo (Supabase Auth), nunca pra acessar o banco direto. Diferente
# da SUPABASE_SERVICE_ROLE_KEY, essa é segura pra rodar no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App do Meta for Developers — NOVO e SEPARADO dos Apps do DirectGov e do Chatbot Direct (Callback
# URL e Verify Token próprios do ShoppingHub).
META_APP_ID=
# Chave secreta do App PRINCIPAL (Configurações do app > Básico) — usada só pra trocar o código
# pelo token no login do Facebook (OAuth).
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Chave secreta do SUB-APP "API do Instagram" (Configurações do app > Casos de uso > API do
# Instagram > Configuração da API com login > "Chave secreta do app do Instagram") — DIFERENTE da
# META_APP_SECRET acima. É essa que a Meta usa pra assinar (x-hub-signature-256) os webhooks de
# mensagens/menções do Instagram — sem ela certa, todo webhook chega e é recusado com 403.
META_INSTAGRAM_APP_SECRET=

# Opcional — só precisa preencher se o domínio fixo do projeto mudar algum dia.
# Sem essa variável, o código usa "https://shoppinghub.vercel.app" por padrão.
NEXT_PUBLIC_APP_URL=

# Chave de API do Gemini (a mesma que já é paga hoje nos projetos irmãos)
GEMINI_API_KEY=

# Opcional — nome do modelo do Gemini. Sem essa variável, o código usa "gemini-flash-lite-latest"
# por padrão. Prefira um apelido que o Google mantém atualizado sozinho (como esse) em vez de uma
# versão fixa — evita ter que trocar código quando o Google aposentar uma versão fixa.
GEMINI_MODEL=

# Segredo pra proteger o endpoint de cron (/api/cron/publicar-mencoes) — a Vercel já manda esse
# valor automaticamente no header "Authorization: Bearer" das chamadas de cron; o código confere
# esse valor pra ninguém mais conseguir disparar a publicação manualmente batendo na URL.
CRON_SECRET=

# Opcional — quantos dias o histórico de mensagens (aba "Atendimentos") fica guardado antes de
# ser apagado automaticamente pelo cron. Sem essa variável, usa 60 dias por padrão.
RETENCAO_MENSAGENS_DIAS=

# Chave de API do Resend (conta em resend.com) — usada só pra mandar por e-mail os relatórios de
# menções e atendimentos que já são exportados automaticamente a cada 30 dias (ver
# exportarRelatoriosDevidos em lib/relatorios.ts). Sem essa variável, a exportação continua
# acontecendo normalmente (CSV salvo no Storage) e só o envio do e-mail é pulado, com um aviso no
# log.
RESEND_API_KEY=

# Opcional — remetente do e-mail acima, no formato "Nome <endereco@dominio>". Sem essa variável,
# usa "ShoppingHub <onboarding@resend.dev>" (o remetente de teste do Resend, que funciona sem
# precisar verificar domínio, mas só entrega pro e-mail da própria conta Resend). Só preencher
# depois de verificar um domínio próprio no Resend.
RESEND_FROM_EMAIL=

# Segredo compartilhado das pontes temporárias com o SendPulse — usado enquanto o App Review do
# ShoppingHub não sai. Tirar essas rotas do ar (ou trocar o segredo) quando as pontes não forem
# mais necessárias.
#   /api/bridge/sendpulse (chat, configurado no construtor de fluxo) — recebe esse valor no header
#   "X-Bridge-Secret".
#   /api/bridge/sendpulse/webhook (menções de Story, configurado em Configurações do Bot > Webhooks
#   > "Mensagens recebidas") — recebe esse valor na própria URL (?secret=...), porque a tela de
#   Global Webhooks da SendPulse só deixa colar uma URL simples, sem campo de cabeçalho.
# Em nenhum caso dá pra usar a assinatura da Meta, porque quem chama é a SendPulse, não a Meta.
SENDPULSE_BRIDGE_SECRET=
